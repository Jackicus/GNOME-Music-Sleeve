# Maintainer: Jack Tully <https://github.com/Jackicus>
#
# The AUR package's source, kept in the app's repository (build-aux/aur/). After any change:
#   updpkgsums && makepkg --printsrcinfo > .SRCINFO
# The source is the GitHub release's `meson dist` tarball, so updpkgsums needs the release.
# .github/workflows/package.yml builds this file into the package attached to each release.
#
# The app's modules install under /usr/share/music-sleeve, outside site-packages, byte-compiled
# for the Python that built the package; Arch's rebuilds for a new Python leave them alone.
# After each Python minor release (3.14 to 3.15, say), bump pkgrel and rebuild, or every start
# compiles the modules again in memory.

pkgname=music-sleeve
pkgver=1.2.0
pkgrel=1
pkgdesc='Native GNOME client for Apple Music, played through Google Chrome'
arch=('any')
url='https://github.com/Jackicus/GNOME-Music-Sleeve'
license=('GPL-2.0-or-later')
depends=(
  'gdk-pixbuf2'
  'glib2'
  'graphene'
  'gtk4'
  'hicolor-icon-theme'
  'libadwaita'
  'pango'
  'python'
  'python-gobject'
)
makedepends=(
  'blueprint-compiler'
  'meson'
)
checkdepends=(
  'appstream'
  'desktop-file-utils'
  'python-cairo'  # scripts/demo_library.py draws the invented library's covers for the tests
)
optdepends=('google-chrome: the playback engine (its Widevine plays the protected streams)')
source=("$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.xz")
sha256sums=('SKIP')

build() {
  arch-meson "$pkgname-$pkgver" build
  meson compile -C build
}

check() {
  # The unit tests (Meson's `unit` suite; the widget tests skip without a display) and the
  # desktop file, metainfo and schema validation.
  meson test -C build --print-errorlogs
}

package() {
  # --skip-subprojects: a build that fell back to the blueprint-compiler wrap would install
  # a file of its own.
  meson install -C build --destdir "$pkgdir" --skip-subprojects
}
