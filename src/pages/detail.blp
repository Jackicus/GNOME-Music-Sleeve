using Gtk 4.0;
using Adw 1;

template $AppleMusicDetailPage: Adw.NavigationPage {
  child: Adw.BreakpointBin {
    width-request: 360;
    height-request: 200;

    // Wide: a playlist's tracks as a table (detail.py follows its apply and unapply: a
    // setter may only change what is inside the bin). Disjoint from the narrow one below.
    Adw.Breakpoint table_breakpoint {
      condition ("min-width: 720sp")
    }

    // Narrow: the cover goes above the text, and the hero centres. The cover beside the text
    // needs 650 px: the cover, their 24 px gap, Play, Shuffle and More Options in a row
    // (318 px, 12 px apart) and the row's 24 px inset each side (style.css's track-list
    // rows); narrower, the page would ask for more than it has. Add (or In Library) and More
    // Options go on a line of their own where the row has no room for them.
    Adw.Breakpoint {
      condition ("max-width: 650sp")

      setters {
        hero_row.orientation: vertical;
        cover.halign: center;
        info_box.valign: start;
        title_label.xalign: 0.5;
        title_label.justify: center;
        subtitle_label.xalign: 0.5;
        subtitle_label.justify: center;
        artist_button.halign: center;
        caption_label.xalign: 0.5;
        caption_label.justify: center;
        buttons_box.halign: center;
        buttons_box.align: 0.5;
        summary_label.xalign: 0.5;
        summary_label.justify: center;
        more_notes_button.halign: center;
      }
    }

    // Narrower still (a phone): the buttons 6 px apart, as one group, since the row's inset
    // leaves 312 px at the 360 px minimum (Play, Shuffle and More Options take 312). The last breakpoint that matches is the one
    // applied, so this repeats the one above.
    Adw.Breakpoint {
      condition ("max-width: 400sp")

      setters {
        hero_row.orientation: vertical;
        cover.halign: center;
        info_box.valign: start;
        title_label.xalign: 0.5;
        title_label.justify: center;
        subtitle_label.xalign: 0.5;
        subtitle_label.justify: center;
        artist_button.halign: center;
        caption_label.xalign: 0.5;
        caption_label.justify: center;
        buttons_box.halign: center;
        buttons_box.align: 0.5;
        buttons_box.child-spacing: 6;
        actions_box.spacing: 6;
        summary_label.xalign: 0.5;
        summary_label.justify: center;
        more_notes_button.halign: center;
      }
    }

    // A playlist's filter bar goes under the header bar, its button in it (detail.py,
    // widgets/filter_bar.py).
    child: Adw.ToolbarView toolbar {
      [top]
      Adw.HeaderBar header_bar {}

      content: Stack stack {
        StackPage {
          name: "loading";

          child: Adw.Spinner {
            width-request: 32;
            height-request: 32;
            halign: center;
            valign: center;
          };
        }

        StackPage {
          name: "empty";
          child: Adw.StatusPage empty_page {};
        }

        StackPage {
          name: "item";

          // The hero and every track in one list, the hero its first row (see detail.py). A
          // click plays a track, as GNOME Music plays one (docs/decisions.md): the links,
          // the context menu and a drag claim their presses before the row sees them.
          child: ScrolledWindow scrolled_window {
            hscrollbar-policy: never;

            child: ListView list_view {
              single-click-activate: true;
              tab-behavior: item;

              styles [
                "track-list",
              ]
            };
          };
        }
      };
    };
  };
}

// The list's first row: cover, title, subtitle, details, Play and Shuffle, the summary, and a
// status page when there are no tracks to follow.
Box hero {
  orientation: vertical;
  spacing: 18;
  margin-top: 18;
  margin-bottom: 12;

  Box hero_row {
    spacing: 24;

    $AppleMusicCover cover {
      size: 260;
      valign: start;

      styles [
        "large",
      ]
    }

    Box info_box {
      orientation: vertical;
      valign: end;
      hexpand: true;
      spacing: 6;

      Label title_label {
        xalign: 0;
        wrap: true;
        wrap-mode: word_char;

        styles [
          "title-1",
        ]
      }

      // The subtitle: an album's artist as a link to their page when the library has them
      // (artist_button), else plain text (a playlist's curator, an artist not in the library).
      Label subtitle_label {
        xalign: 0;
        wrap: true;
        wrap-mode: word_char;

        styles [
          "title-3",
        ]
      }

      Button artist_button {
        halign: start;
        visible: false;

        child: Label artist_label {
          xalign: 0;
          wrap: true;
          wrap-mode: word_char;

          styles [
            "title-3",
          ]
        };

        // A link as the tables' are (style.css: plain, underlined under the pointer), not a
        // "link" button's blue.
        styles [
          "flat",
          "artist-link",
        ]
      }

      Label caption_label {
        xalign: 0;
        wrap: true;

        styles [
          "caption",
          "dimmed",
        ]
      }

      // Play, Shuffle, then Add or In Library with More Options, those two together on a
      // second line where they do not fit on the first. The labels may ellipsize
      // (can-shrink): a language whose words are long keeps the row within the 360 px
      // minimum rather than pushing the page past it; the English ones fit whole
      // (tests/test_detail_page.py).
      Adw.WrapBox buttons_box {
        child-spacing: 12;
        line-spacing: 12;
        margin-top: 12;

        Button play_button {
          child: Adw.ButtonContent {
            icon-name: "media-playback-start-symbolic";
            label: _("Play");
            can-shrink: true;
          };

          styles [
            "pill",
            "suggested-action",
          ]
        }

        Button shuffle_button {
          child: Adw.ButtonContent {
            icon-name: "media-playlist-shuffle-symbolic";
            label: _("Shuffle");
            can-shrink: true;
          };

          styles [
            "pill",
          ]
        }

        Box actions_box {
          spacing: 12;

          // An album or playlist of the catalog's that the library lacks: Add adds it
          // (detail.library_state()); once the library holds it, In Library says so instead.
          Button add_button {
            visible: false;
            tooltip-text: _("Add to Library");

            child: Adw.ButtonContent {
              icon-name: "list-add-symbolic";
              label: _("Add");
              can-shrink: true;
            };

            styles [
              "pill",
            ]
          }

          // A state, not a button: the item's menu has what more can be done.
          Box in_library_box {
            visible: false;
            spacing: 6;
            valign: center;
            margin-start: 6;
            margin-end: 6;

            Image {
              icon-name: "object-select-symbolic";
              accessible-role: presentation;
            }

            Label {
              label: _("In Library");
            }

            styles [
              "dimmed",
            ]
          }

          // The item's own menu (Favourite, Add to Library, Play Next…), made as it opens.
          MenuButton more_button {
            icon-name: "view-more-symbolic";
            tooltip-text: _("More Options");
            valign: center;

            accessibility {
              label: _("More Options");
            }

            styles [
              "circular",
            ]
          }
        }
      }
    }
  }

  // The notes, three lines at most; More shows them whole, when they are cut (detail.py).
  Box summary_box {
    orientation: vertical;
    spacing: 6;
    visible: false;

    Label summary_label {
      xalign: 0;
      wrap: true;
      lines: 3;
      ellipsize: end;

      styles [
        "dimmed",
      ]
    }

    Button more_notes_button {
      label: _("More");
      halign: start;
      visible: false;

      styles [
        "flat",
      ]
    }
  }

  // In place of the tracks: an item that came without them (a shelf's) while the engine
  // fetches them, what stopped the fetch (the engine down, not signed in, an error) with a
  // button that helps, or an empty playlist. A compact status page's look (its 96px icon, its
  // title-2, its spacing), but not an Adw.StatusPage: a list row gets its minimum height, and
  // a status page, a scrolled window inside, asks for a fifth of what it shows. While the
  // tracks are fetched, the spinner alone, as every page's loading state is.
  Box status_box {
    orientation: vertical;
    spacing: 12;
    margin-top: 24;
    margin-bottom: 24;
    visible: false;

    Image status_icon {
      icon-name: "music-note-symbolic";
      pixel-size: 96;
      margin-bottom: 12;
      accessible-role: presentation;

      styles [
        "dimmed",
      ]
    }

    Adw.Spinner status_spinner {
      width-request: 32;
      height-request: 32;
      halign: center;
      visible: false;
    }

    Label status_title {
      wrap: true;
      justify: center;

      styles [
        "title-2",
      ]
    }

    Label status_description {
      wrap: true;
      justify: center;
    }

    Button status_button {
      halign: center;
      margin-top: 12;

      styles [
        "pill",
        "suggested-action",
      ]
    }
  }
}

// After an album's last disc: its release date in full, its songs and their time, and its
// copyright line (release.footer_lines), as Apple Music's clients end an album.
Label footer_label {
  xalign: 0;
  wrap: true;
  wrap-mode: word_char;
  margin-top: 6;
  margin-bottom: 6;

  styles [
    "caption",
    "dimmed",
  ]
}

// Under the footer: the catalog's shelves of the album (detail.py's ShelfColumn: Other
// Versions, Music Videos, More By, Featured On, You Might Also Like), out to the page's edges
// as an artist page's are (style.css undoes the rows' inset).
Box shelves_box {
  orientation: vertical;
  spacing: 24;
  margin-top: 18;

  styles [
    "album-shelves",
  ]
}
