using Gtk 4.0;
using Adw 1;

template $AppleMusicSongsPage: Adw.NavigationPage {
  child: Adw.BreakpointBin {
    width-request: 360;
    height-request: 200;

    // Medium: no room for the optional Genre and Year columns (song_columns.py), which
    // songs.py leaves out while this applies, or the narrow one: the six fixed widths are
    // 630 px. No setters: the columns shown follow a setting.
    Adw.Breakpoint medium_breakpoint {
      condition ("max-width: 760sp")
    }

    // Narrow: the album and artist columns go, the artist shown under the title instead
    // (songs.py stacks the title cells as this applies), so that the title has the room and
    // title and time fit a 360 px window; Play and Shuffle go under the page's title.
    Adw.Breakpoint narrow_breakpoint {
      condition ("max-width: 560sp")

      setters {
        album_column.visible: false;
        artist_column.visible: false;
        title_column.fixed-width: 260;
        heading_box.orientation: vertical;
      }
    }

    child: Adw.ToolbarView toolbar {
      [top]
      Adw.HeaderBar header_bar {
        show-title: false;

        [end]
        MenuButton sort_button {
          icon-name: "view-sort-descending-symbolic";
          tooltip-text: _("Sort and Filter");
          menu-model: sort_menu;
          visible: false;

          accessibility {
            label: _("Sort and Filter");
          }
        }

        // The filter bar's button (widgets/filter_bar.py) goes beside it, and the bar under
        // the header bar: songs.py adds them.
      }

      content: Stack stack {
        StackPage {
          name: "loading";

          child: Adw.Spinner {
            width-request: 32;
            height-request: 32;
            halign: center;
            valign: center;
          };
        }

        StackPage {
          name: "empty";
          child: Adw.StatusPage empty_page {};
        }

        StackPage {
          name: "items";

          // The title stays put above the table: a Gtk.ColumnView only recycles its rows as
          // the scrollable child of a Gtk.ScrolledWindow, and its header row is its own. On
          // the view background, as the grid pages' titles are.
          child: Box {
            orientation: vertical;

            styles [
              "view",
            ]

            // The title and the count, then Play and Shuffle: beside them, or under them in
            // the narrow table (the breakpoint turns the box), as an album's page has them
            // under its title.
            Box heading_box {
              spacing: 12;
              margin-start: 24;
              margin-end: 24;
              margin-top: 24;
              margin-bottom: 12;

              Box {
                spacing: 12;
                hexpand: true;

                Label title_label {
                  xalign: 0;
                  ellipsize: end;
                  valign: baseline_fill;

                  styles [
                    "title-1",
                  ]
                }

                Label count_label {
                  xalign: 0;
                  hexpand: true;
                  ellipsize: end;
                  valign: baseline_fill;

                  styles [
                    "dimmed",
                  ]
                }
              }

              // What the table shows, in its order (songs.play_target()).
              Box {
                spacing: 12;
                halign: start;
                valign: center;

                Button play_button {
                  child: Adw.ButtonContent {
                    icon-name: "media-playback-start-symbolic";
                    label: _("Play");
                    can-shrink: true;
                  };

                  styles [
                    "pill",
                    "suggested-action",
                  ]
                }

                Button shuffle_button {
                  child: Adw.ButtonContent {
                    icon-name: "media-playlist-shuffle-symbolic";
                    label: _("Shuffle");
                    can-shrink: true;
                  };

                  styles [
                    "pill",
                  ]
                }
              }
            }

            Stack results_stack {
              vexpand: true;

              StackPage {
                name: "table";

                child: ScrolledWindow {
                  hscrollbar-policy: never;

                  // A click plays a song, as GNOME Music plays one (docs/decisions.md): the
                  // links, the context menu and a drag claim their presses before the row
                  // sees them. No row separators, as a playlist's table has none.
                  child: ColumnView column_view {
                    tab-behavior: item;
                    single-click-activate: true;
                    activate => $on_activate();

                    styles [
                      "songs-table",
                    ]

                    // Fixed widths, shared out as the table grows, keep the columns from
                    // measuring their cells: rows are rebound all the time while scrolling,
                    // and widths that followed the text shown would jump as it changed.
                    // Title and time alone (the narrow breakpoint's) fit a 360 px window:
                    // 356 px.
                    ColumnViewColumn title_column {
                      title: _("Title");
                      fixed-width: 170;
                      expand: true;
                      resizable: true;
                    }

                    ColumnViewColumn artist_column {
                      title: _("Artist");
                      fixed-width: 100;
                      expand: true;
                      resizable: true;
                    }

                    ColumnViewColumn album_column {
                      title: _("Album");
                      fixed-width: 100;
                      expand: true;
                      resizable: true;
                    }

                    // The optional columns (song_columns.py, the song-columns setting):
                    // songs.py shows them.
                    ColumnViewColumn genre_column {
                      title: _("Genre");
                      fixed-width: 100;
                      expand: true;
                      resizable: true;
                      visible: false;
                    }

                    // Four digits and the cell's padding.
                    ColumnViewColumn year_column {
                      title: _("Year");
                      fixed-width: 64;
                      visible: false;
                    }

                    // Room for an hour or more ("1:02:03", 56 px at Adwaita Sans 11) beside
                    // the cell's 6 px and the page margin's 24 px.
                    ColumnViewColumn time_column {
                      title: _("Time");
                      fixed-width: 96;
                    }
                  };
                };
              }

              StackPage {
                name: "no-results";

                // Or, with Favourites Only and no text to filter by, no favourites
                // (songs.py sets its words).
                child: Adw.StatusPage no_results_page {
                  icon-name: "edit-find-symbolic";
                  title: _("No Results Found");
                  description: _("Try a different filter");
                };
              }
            }
          };
        }
      };
    };
  };
}

// The Sort and Filter menu (songs.py's songs.* actions): the keyboard's way to sort, as the
// column headers take no focus, and Favourites Only; songs.py adds the optional columns'
// section (song_columns.menu_section()). Each label's mnemonic is its own in the menu; the
// directions' and Favourites Only's are grid.sort_labels()', the columns' song_columns'.
menu sort_menu {
  section {
    item {
      label: _("_Title");
      action: "songs.sort-column";
      target: "title";
    }

    item {
      label: _("_Artist");
      action: "songs.sort-column";
      target: "artist";
    }

    item {
      label: _("Al_bum");
      action: "songs.sort-column";
      target: "album";
    }

    item {
      label: _("_Genre");
      action: "songs.sort-column";
      target: "genre";
    }

    item {
      label: _("_Year");
      action: "songs.sort-column";
      target: "year";
    }

    item {
      label: _("T_ime");
      action: "songs.sort-column";
      target: "time";
    }
  }

  section {
    item {
      label: _("Asc_ending");
      action: "songs.sort-order";
      target: "ascending";
    }

    item {
      label: _("Desce_nding");
      action: "songs.sort-order";
      target: "descending";
    }
  }

  section {
    item {
      label: _("_Favourites Only");
      action: "songs.favourites-only";
    }
  }
}
