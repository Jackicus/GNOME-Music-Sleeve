using Gtk 4.0;
using Adw 1;

template $AppleMusicSearchPage: Adw.NavigationPage {
  child: Adw.BreakpointBin {
    width-request: 360;
    height-request: 200;

    // Narrow: the mode toggle under the entry (and its filter). Narrower still: the category
    // tiles one a line too (two would break their names mid-word).
    Adw.Breakpoint {
      condition ("max-width: 640sp")

      setters {
        search_row.orientation: vertical;
        mode_toggle.halign: center;
      }
    }

    Adw.Breakpoint {
      condition ("max-width: 520sp")

      setters {
        search_row.orientation: vertical;
        mode_toggle.halign: center;
        categories_box.min-children-per-line: 1;
        categories_box.max-children-per-line: 1;
      }
    }

    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        show-title: false;
      }

      content: Box {
        orientation: vertical;

        styles [
          "view",
        ]

        // The entry, the mode and (Apple Music's) the kind of results shown, centred as wide
        // as the suggestions under them, with no title: the entry names the page. The page's
        // handlers are connected in search.py (weakly: sign-out drops it).
        Adw.Clamp {
          maximum-size: 720;
          tightening-threshold: 600;
          margin-start: 24;
          margin-end: 24;
          margin-top: 6;
          margin-bottom: 12;

          child: Box search_row {
            spacing: 12;

            // The entry and, in Apple Music mode, which kind of results it shows: every kind
            // (the shelves) or one (a list that loads more as it is scrolled). search.py fills
            // the filter from FILTER_KEYS.
            Box {
              spacing: 12;
              hexpand: true;

              SearchEntry search_entry {
                hexpand: true;
                placeholder-text: _("Search Apple Music");

                accessibility {
                  label: _("Search");
                }
              }

              DropDown kind_dropdown {
                valign: center;
                tooltip-text: _("Show Results Of");

                accessibility {
                  label: _("Show Results Of");
                }
              }
            }

            Adw.ToggleGroup mode_toggle {
              valign: center;

              accessibility {
                label: _("Search In");
              }

              Adw.Toggle {
                name: "music";
                label: _("Apple Music");
              }

              Adw.Toggle {
                name: "library";
                label: _("Your Library");
              }
            }
          };
        }

        Stack stack {
          vexpand: true;

          StackPage {
            name: "loading";

            child: Adw.Spinner {
              width-request: 32;
              height-request: 32;
              halign: center;
              valign: center;
            };
          }

          // Engine down, signed out, a failed search, no results, or Your Library before
          // anything is typed: one status page, worded by search.py.
          StackPage {
            name: "status";

            child: Adw.StatusPage status_page {
              child: Box {
                orientation: vertical;
                spacing: 12;
                halign: center;

                Button status_button {
                  visible: false;

                  styles [
                    "pill",
                    "suggested-action",
                  ]
                }

                // Your Library works whatever the engine: offered where Apple Music cannot
                // answer (the engine down, signed out, the demo), as the plain second button
                // under the suggested one.
                Button status_library_button {
                  label: _("Search Your Library");
                  visible: false;

                  styles [
                    "pill",
                  ]
                }
              };
            };
          }

          // Before anything is typed: what was opened from Search lately (recent_searches.py)
          // and Apple's browse categories, flow boxes of tiles (at most LIMIT and a few tens,
          // made once each; a Gtk.GridView could not sit under a heading in one scrolled
          // window).
          StackPage {
            name: "landing";

            child: ScrolledWindow {
              hscrollbar-policy: never;

              child: Box {
                orientation: vertical;
                spacing: 12;
                margin-bottom: 18;

                Box recent_header {
                  spacing: 12;
                  margin-start: 24;
                  margin-end: 14;

                  styles [
                    "shelf-header",
                  ]

                  Label recent_title_label {
                    label: _("Recently Searched");
                    xalign: 0;
                    ellipsize: end;
                    hexpand: true;

                    styles [
                      "title-2",
                    ]
                  }

                  Button recent_clear_button {
                    label: _("Clear");
                    valign: center;
                    tooltip-text: _("Clear Recently Searched");

                    styles [
                      "flat",
                    ]
                  }
                }

                FlowBox recent_box {
                  homogeneous: true;
                  selection-mode: none;
                  activate-on-single-click: true;
                  min-children-per-line: 1;
                  max-children-per-line: 5;
                  column-spacing: 12;
                  row-spacing: 12;
                  valign: start;
                  margin-start: 24;
                  margin-end: 24;
                  margin-bottom: 12;

                  accessibility {
                    labelled-by: [
                      recent_title_label,
                    ];
                  }
                }

                Label categories_title_label {
                  label: _("Browse Categories");
                  xalign: 0;
                  ellipsize: end;
                  margin-start: 24;
                  margin-end: 24;

                  styles [
                    "title-2",
                  ]
                }

                FlowBox categories_box {
                  homogeneous: true;
                  selection-mode: none;
                  activate-on-single-click: true;
                  min-children-per-line: 2;
                  max-children-per-line: 6;
                  column-spacing: 12;
                  row-spacing: 12;
                  valign: start;
                  margin-start: 24;
                  margin-end: 24;
                }
              };
            };
          }

          // While typing: Apple's completions of the term and its top hits for it.
          StackPage {
            name: "suggestions";

            child: ScrolledWindow {
              hscrollbar-policy: never;

              child: Adw.Clamp {
                maximum-size: 720;
                tightening-threshold: 600;
                margin-start: 24;
                margin-end: 24;
                margin-top: 6;
                margin-bottom: 18;

                child: ListBox suggestions_list {
                  selection-mode: none;
                  valign: start;

                  styles [
                    "boxed-list",
                  ]
                };
              };
            };
          }

          // After Enter: one shelf per kind, in Apple's order, Top Results as cards.
          StackPage {
            name: "results";

            child: ScrolledWindow {
              hscrollbar-policy: never;

              child: Box results_box {
                orientation: vertical;
                spacing: 18;
                margin-top: 6;
                margin-bottom: 18;
              };
            };
          }

          // After Enter with a kind chosen: that kind alone, a list that loads more as it
          // is scrolled (widgets/search_list.py).
          StackPage {
            name: "kind";
            child: $AppleMusicSearchList kind_list {};
          }

          // Your Library: the cached models filtered as you type, in Apple's order: Top
          // Results as cards (search.top_results()), the songs (the first SONG_LIMIT; See All
          // opens the Songs page with the filter), then the artists, albums and playlists.
          StackPage {
            name: "library";

            child: ScrolledWindow {
              hscrollbar-policy: never;

              child: Box library_box {
                orientation: vertical;
                spacing: 18;
                margin-top: 6;
                margin-bottom: 18;

                $AppleMusicShelf top_shelf {
                  hero: true;
                }

                Box songs_box {
                  orientation: vertical;

                  Box {
                    spacing: 12;
                    margin-start: 24;
                    margin-end: 14;

                    styles [
                      "shelf-header",
                    ]

                    Box {
                      orientation: vertical;
                      valign: center;
                      hexpand: true;

                      Label songs_title_label {
                        label: _("Songs");
                        xalign: 0;
                        ellipsize: end;

                        styles [
                          "title-2",
                        ]
                      }

                      Label songs_count_label {
                        xalign: 0;
                        ellipsize: end;

                        styles [
                          "dimmed",
                        ]
                      }
                    }

                    Button songs_see_all_button {
                      label: _("See All");
                      valign: center;

                      accessibility {
                        described-by: [
                          songs_title_label,
                        ];
                      }

                      styles [
                        "flat",
                      ]
                    }
                  }

                  // A short list in the page's own scrolled window: at most SONG_LIMIT rows,
                  // so the list need not recycle (it cannot, inside a box). A click plays a
                  // song, as GNOME Music plays one (docs/decisions.md).
                  ListView songs_list {
                    single-click-activate: true;
                    tab-behavior: item;

                    styles [
                      "track-list",
                    ]
                  }
                }

                $AppleMusicShelf artists_shelf {
                  see-all: true;
                }

                $AppleMusicShelf albums_shelf {
                  see-all: true;
                }

                $AppleMusicShelf playlists_shelf {
                  see-all: true;
                }
              };
            };
          }
        }
      };
    };
  };
}
