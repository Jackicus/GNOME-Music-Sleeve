using Gtk 4.0;
using Adw 1;

template $AppleMusicShelvesPage: Adw.NavigationPage {
  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar header_bar {
      show-title: false;

      [end]
      Button refresh_button {
        icon-name: "view-refresh-symbolic";
        tooltip-text: _("Refresh");
      }
    }

    content: Stack stack {
      StackPage {
        name: "loading";

        child: Adw.Spinner {
          width-request: 32;
          height-request: 32;
          halign: center;
          valign: center;
        };
      }

      StackPage {
        name: "status";

        child: Adw.StatusPage status_page {
          child: Button status_button {
            halign: center;
            visible: false;

            styles [
              "pill",
              "suggested-action",
            ]
          };
        };
      }

      StackPage {
        name: "items";

        // A box of shelves, as Home: a page has a handful, and each recycles its own tiles
        // in its own scrolled window. On the view background, as the grids and lists are.
        child: ScrolledWindow scrolled_window {
          hscrollbar-policy: never;

          styles [
            "view",
          ]

          child: Box shelves_box {
            orientation: vertical;
            spacing: 18;
            margin-bottom: 18;

            // The title, and a radio show's host under it; over the curator's wide banner
            // when it has one (shelves.py's _show_header), the text in white at its foot. The
            // overlay is as tall as the taller of the two.
            Overlay hero {
              child: $AppleMusicArtistBanner banner {
                visible: false;
                accessible-role: presentation;
              };

              [overlay]
              Box hero_box {
                orientation: vertical;
                spacing: 6;
                margin-start: 24;
                margin-end: 24;
                margin-top: 24;

                layout {
                  measure: true;
                }

                Label title_label {
                  xalign: 0;
                  ellipsize: end;

                  styles [
                    "title-1",
                  ]
                }

                Label caption_label {
                  xalign: 0;
                  wrap: true;
                  visible: false;

                  styles [
                    "caption",
                    "dimmed",
                  ]
                }
              }
            }
          };
        };
      }
    };
  };
}
