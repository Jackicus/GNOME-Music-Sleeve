using Gtk 4.0;
using Adw 1;

template $AppleMusicAddSongsDialog: Adw.Dialog {
  title: _("Add Songs");
  content-width: 520;
  content-height: 640;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button cancel_button {
        label: _("_Cancel");
        use-underline: true;
      }

      title-widget: Adw.WindowTitle window_title {
        title: _("Add Songs");
      };

      [end]
      Button add_button {
        label: _("_Add");
        use-underline: true;
        sensitive: false;

        styles [
          "suggested-action",
        ]
      }
    }

    // The search, and where it looks: the library's songs (all of them before anything is
    // typed) or Apple Music's catalogue.
    [top]
    Box {
      orientation: vertical;
      spacing: 6;
      margin-start: 12;
      margin-end: 12;
      margin-bottom: 6;

      Adw.Clamp {
        maximum-size: 400;

        child: SearchEntry search_entry {
          hexpand: true;
          placeholder-text: _("Search Songs");

          accessibility {
            label: _("Search Songs");
          }
        };
      }

      Adw.ToggleGroup scope_toggle {
        halign: center;

        accessibility {
          label: _("Search In");
        }

        Adw.Toggle {
          name: "library";
          label: _("Your Library");
        }

        Adw.Toggle {
          name: "catalog";
          label: _("Apple Music");
        }
      }
    }

    content: Stack stack {
      transition-type: crossfade;

      StackPage {
        name: "library";

        child: ScrolledWindow library_scrolled {
          hscrollbar-policy: never;
          vexpand: true;

          child: Adw.ClampScrollable {
            maximum-size: 720;
            tightening-threshold: 600;

            child: ListView library_view {
              single-click-activate: true;
              tab-behavior: item;

              styles [
                "track-list",
                "search-results",
              ]

              accessibility {
                label: _("Your Library");
              }
            };
          };
        };
      }

      StackPage {
        name: "catalog";

        child: $AppleMusicPickList catalog_list {};
      }

      StackPage {
        name: "loading";

        child: Adw.Spinner {
          width-request: 32;
          height-request: 32;
          halign: center;
          valign: center;
        };
      }

      StackPage {
        name: "status";

        child: Adw.StatusPage status_page {
          icon-name: "edit-find-symbolic";

          styles [
            "compact",
          ]

          child: Button status_button {
            halign: center;
            visible: false;
            use-underline: true;

            styles [
              "pill",
              "suggested-action",
            ]
          };
        };
      }
    };
  };
}
