using Gtk 4.0;
using Adw 1;

// Preferences (app.preferences, Ctrl+,): each row bound to its setting in preferences.py.
// Switch and action rows carry a short, header-capitalised title and say the rest in their
// subtitle, as Settings does; an entry row's title is sentence-cased.
template $AppleMusicPreferencesDialog: Adw.PreferencesDialog {
  Adw.PreferencesPage general_page {
    name: "general";
    title: _("General");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Playback");

      Adw.SwitchRow background_row {
        title: _("Background Playback");
        subtitle: _("Keep playing when the window is closed; the system’s media controls bring it back");
      }

      Adw.SwitchRow autoplay_row {
        title: _("Autoplay");
        subtitle: _("When the queue ends, keep playing similar songs, shown in Up Next");
      }

      Adw.SwitchRow notify_song_row {
        title: _("Notify When the Song Changes");
        subtitle: _("Show each new song’s title, artist and cover while the app is in the background");
      }

      Adw.SwitchRow discord_row {
        title: _("Discord Presence");
        subtitle: _("Show the song playing, with its artist, album and cover, on your Discord profile while Discord is running");
      }
    }

    // What a playlist's Suggested Songs show (pages/detail.py).
    Adw.PreferencesGroup {
      title: _("Suggested Songs");

      Adw.SwitchRow more_suggestions_row {
        title: _("Show More Suggestions");
        subtitle: _("Twelve songs under a playlist instead of six");
      }

      Adw.SwitchRow preview_suggestions_row {
        title: _("Preview Suggestions");
        subtitle: _("Play a 30-second preview of a suggested song instead of the whole song");
      }
    }

    Adw.PreferencesGroup {
      title: _("Library");

      // The sidebar's Genres (sections.py).
      Adw.SwitchRow genres_row {
        title: _("Show Genres");
        subtitle: _("List the library’s albums by genre in the sidebar");
      }

      Adw.ComboRow interval_row {
        title: _("Refresh Library");

        model: StringList {
          strings [
            _("Every hour"),
            _("Every 6 hours"),
            _("Every day"),
            _("Manually"),
          ]
        };
      }

      // The subtitle is when the library was last refreshed (sync.last_sync_text()), or
      // "Refreshing…" while it is; Refresh runs app.sync, off while it cannot run.
      Adw.ActionRow last_refreshed_row {
        title: _("Last Refreshed");

        [suffix]
        Button refresh_button {
          label: _("_Refresh");
          use-underline: true;
          valign: center;
          action-name: "app.sync";
        }
      }

      Adw.ActionRow cache_row {
        title: _("Cache");
        subtitle: _("Calculating…");

        [suffix]
        Button clear_button {
          label: _("C_lear…");
          use-underline: true;
          valign: center;
        }
      }
    }
  }

  Adw.PreferencesPage engine_page {
    name: "engine";
    title: _("Engine");
    icon-name: "web-browser-symbolic";

    Adw.PreferencesGroup {
      description: _("Apple Music plays in Google Chrome, which the app starts and controls in the background. Another Chromium-based browser with Widevine can be used instead.");

      Adw.ActionRow engine_row {
        title: _("Engine");
        subtitle: _("Not running");

        [suffix]
        Button engine_button {
          label: _("_Start");
          use-underline: true;
          valign: center;
        }
      }

      // The streaming-quality setting, in engine.QUALITIES' order; the subtitle says the
      // bitrate MusicKit streams at while the engine runs (preferences.py).
      Adw.ComboRow quality_row {
        title: _("Streaming Quality");
        subtitle: _("High Efficiency uses less data");

        model: StringList {
          strings [
            _("High Quality"),
            _("High Efficiency"),
          ]
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Browser");
      description: _("The browser program is a program name or path, without arguments, such as google-chrome-stable or brave-browser. Changes here apply the next time the engine starts; another browser may need you to sign in again.");

      Adw.EntryRow browser_row {
        title: _("Browser program");
        show-apply-button: true;
      }

      Adw.SwitchRow headless_row {
        title: _("Run Browser Hidden");
        subtitle: _("Turn off to show the browser window, for debugging");
      }

      Adw.SwitchRow autostart_row {
        title: _("Start Engine on Launch");
        subtitle: _("Starts the browser when the app opens, once you have signed in");
      }
    }

    Adw.PreferencesGroup account_group {
      title: _("Account");

      // Neither runs its action through action-name: Sign In closes Preferences first, and
      // Sign Out is insensitive while it runs, which an actionable row would undo.
      Adw.ButtonRow sign_in_row {
        title: _("Sign _In…");
        use-underline: true;
      }

      Adw.ButtonRow sign_out_row {
        title: _("Sign _Out…");
        use-underline: true;

        styles [
          "destructive-action",
        ]
      }
    }
  }
}
