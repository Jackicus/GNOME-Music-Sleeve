using Gtk 4.0;

// At the start of its cell: a grid's and a flow box's cells grow with the page, and the first
// column stays on the page's margin. The tooltip (the whole text when a line is cut short) is
// tile.py's.
template $AppleMusicTile: Box {
  orientation: vertical;
  halign: start;
  valign: start;
  margin-top: 6;
  margin-bottom: 6;
  has-tooltip: true;

  styles [
    "tile",
  ]

  // The artwork: a placeholder card under the cover, which is drawn over it when decoded.
  // The overlay takes the placeholder's size, so the cover is 160×160 (284×160 for a music
  // video, tile.py) whatever it decodes to.
  Overlay cover {
    margin-bottom: 6;

    child: Box art_box {
      width-request: 160;
      height-request: 160;

      styles [
        "card",
        "tile-art",
      ]

      Image placeholder_icon {
        icon-name: "music-note-symbolic";
        pixel-size: 48;
        hexpand: true;
        accessible-role: presentation;

        styles [
          "dimmed",
        ]
      }
    };

    [overlay]
    Picture picture {
      content-fit: cover;
      overflow: hidden;
      accessible-role: presentation;

      styles [
        "tile-art",
      ]
    }
  }

  // The title and the subtitle, one line each, cut short with an ellipsis, so every tile in a
  // row is as tall as the next and the subtitles line up. Gtk.Inscriptions: unlike a
  // Gtk.Label, their size comes from their line count, not their text, so rebinding a tile to
  // another item redraws it without laying the grid out again, which is what keeps scrolling
  // smooth (a Gtk.GridView rebinds an item many times as it scrolls past).
  Inscription title_label {
    xalign: 0;
    min-lines: 1;
    text-overflow: ellipsize_end;
  }

  // An artist's tile has none (tile.py); an empty one keeps its line.
  Inscription subtitle_label {
    xalign: 0;
    min-lines: 1;
    text-overflow: ellipsize_end;

    styles [
      "caption",
      "dimmed",
    ]
  }
}
