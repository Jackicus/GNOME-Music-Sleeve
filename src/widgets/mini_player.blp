using Gtk 4.0;
using Adw 1;

// The mini player's content (widgets/mini_player.py; its window is MiniPlayer): a flat
// header bar with Return to Main Window, then the artwork, the title and artist, the seek
// row (LIVE in its place for a live radio station) and one row of seven buttons: Favourite
// and Shuffle, Previous, Play and Next, Repeat and Volume, in that order at every size (the
// window is never narrower than the row). The cover is as large as the controls' room lets
// it be, or small beside the titles where that is low (mini_player.layout_for(), applied as
// `body` is allocated). In the header bar's end, the Lyrics and Up Next toggles (the
// window's win.show-lyrics and win.show-queue), each opening the pane under the controls:
// `pane_slot`, which holds the Now Playing sheet's own LyricsView or QueueView while it
// shows (mini_player.Panes). The controls and the pane are the two children of `paned`,
// whose handle is the divider the user drags between them. Under it all, the artwork's
// tint, as the Now Playing sheet's (widgets/backdrop.py).
template $AppleMusicMiniPlayerView: Adw.Bin {
  styles [
    "mini-player",
  ]

  child: Overlay overlay {
    child: $AppleMusicArtworkBackdrop backdrop {
      tint: true;
    };

    [overlay]
    Adw.ToolbarView toolbar {
      [top]
      Adw.HeaderBar header_bar {
        show-title: false;

        styles [
          "flat",
        ]

        // app.mini-player: back to the main window (its tooltip adds the key: mini_player.py).
        [start]
        Button main_window_button {
          icon-name: "view-fullscreen-symbolic";
          tooltip-text: _("Return to Main Window");
          action-name: "app.mini-player";
        }

        // The panes' toggles, as the player bar's: pressed while its pane shows, Lyrics off
        // for a song without lyrics. Their tooltips add the shortcut (mini_player.py).
        [end]
        ToggleButton queue_button {
          icon-name: "view-list-ordered-symbolic";
          tooltip-text: _("Up Next");
          action-name: "win.show-queue";

          accessibility {
            label: _("Up Next");
          }
        }

        [end]
        ToggleButton lyrics_button {
          icon-name: "media-view-subtitles-symbolic";
          tooltip-text: _("Lyrics");
          action-name: "win.show-lyrics";

          accessibility {
            label: _("Lyrics");
          }
        }
      }

      content: Adw.ToastOverlay toast_overlay {
        // The controls over the pane. Neither shrinks under its least height, so the
        // divider moves between the short layout and the pane's least; a window resized
        // gives or takes the pane's room.
        child: Paned paned {
          orientation: vertical;
          shrink-start-child: false;
          shrink-end-child: false;
          resize-start-child: false;
          resize-end-child: true;

          start-child: $AppleMusicMiniPlayerBody body {
            child: Box content_box {
              orientation: vertical;
              spacing: 12;
              margin-start: 18;
              margin-end: 18;
              margin-top: 6;
              margin-bottom: 18;
              valign: center;

              // The artwork over the titles, or beside them when the window is low.
              Box item_box {
                orientation: vertical;
                spacing: 12;

                $AppleMusicCover cover {
                  size: 256;
                  halign: center;

                  styles [
                    "large",
                  ]
                }

                // The title a size larger than the line under it, as the bar's, the sheet's and
                // the full screen's are.
                Box titles_box {
                  orientation: vertical;
                  spacing: 2;
                  valign: center;

                  Label title_label {
                    label: _("Not Playing");
                    justify: center;
                    ellipsize: end;
                    single-line-mode: true;

                    styles [
                      "title-4",
                    ]
                  }

                  Label subtitle_label {
                    justify: center;
                    ellipsize: end;
                    single-line-mode: true;
                    visible: false;

                    styles [
                      "dimmed",
                    ]
                  }
                }
              }

              Box seek_box {
                spacing: 6;
                sensitive: false;

                Label elapsed_label {
                  label: "0:00";
                  xalign: 1;
                  width-chars: 5;
                  valign: center;

                  styles [
                    "numeric",
                    "caption",
                    "dimmed",
                  ]
                }

                // The scale, or the LIVE badge in its place for a live radio station
                // (SeekControl): one stack, so the row keeps its height.
                Stack seek_stack {
                  hexpand: true;
                  valign: center;
                  transition-type: crossfade;

                  Scale seek_scale {
                    hexpand: true;
                    valign: center;
                    draw-value: false;
                    adjustment: Adjustment seek_adjustment {
                      lower: 0;
                      upper: 1;
                      step-increment: 5;
                      page-increment: 30;
                    };

                    accessibility {
                      label: _("Position");
                    }
                  }

                  Label live_label {
                    // Translators: the badge in place of the position slider while a live radio station plays
                    label: C_("live badge", "LIVE");
                    tooltip-text: _("Live Radio");
                    halign: center;
                    valign: center;

                    accessibility {
                      label: _("Live Radio");
                    }

                    styles [
                      "caption-heading",
                      "live-badge",
                    ]
                  }
                }

                Label remaining_label {
                  label: "-0:00";
                  xalign: 0;
                  width-chars: 6;
                  valign: center;

                  styles [
                    "numeric",
                    "caption",
                    "dimmed",
                  ]
                }
              }

              // One row at every size, in the order it reads: Favourite and Shuffle, the
              // transport, Repeat and Volume. Its width with the side margins is the
              // window's least (mini_player.MIN_WIDTH).
              Box transport_box {
                spacing: 10;
                halign: center;

                // Whether the item playing is loved (widgets/transport.py's HeartControl).
                ToggleButton heart_button {
                  icon-name: "heart-outline-symbolic";
                  tooltip-text: _("Favourite");
                  sensitive: false;
                  valign: center;

                  accessibility {
                    label: _("Favourite");
                  }

                  styles [
                    "flat",
                    "circular",
                    "heart-button",
                  ]
                }

                ToggleButton shuffle_button {
                  icon-name: "media-playlist-shuffle-symbolic";
                  tooltip-text: _("Shuffle");
                  sensitive: false;
                  valign: center;

                  styles [
                    "flat",
                    "circular",
                  ]
                }

                Button previous_button {
                  icon-name: "media-skip-backward-symbolic";
                  tooltip-text: _("Previous");
                  action-name: "app.previous";
                  valign: center;

                  styles [
                    "flat",
                    "circular",
                    "skip-button",
                  ]
                }

                Button play_button {
                  icon-name: "transport-play-symbolic";
                  tooltip-text: _("Play");
                  action-name: "app.play-pause";
                  valign: center;

                  styles [
                    "circular",
                    "suggested-action",
                    "play-button",
                  ]
                }

                Button next_button {
                  icon-name: "media-skip-forward-symbolic";
                  tooltip-text: _("Next");
                  action-name: "app.next";
                  valign: center;

                  styles [
                    "flat",
                    "circular",
                    "skip-button",
                  ]
                }

                ToggleButton repeat_button {
                  icon-name: "media-playlist-repeat-symbolic";
                  tooltip-text: _("Repeat");
                  sensitive: false;
                  valign: center;

                  styles [
                    "flat",
                    "circular",
                  ]
                }

                ScaleButton volume_button {
                  icons: [
                    "audio-volume-muted-symbolic",
                    "audio-volume-high-symbolic",
                    "audio-volume-low-symbolic",
                    "audio-volume-medium-symbolic",
                  ];
                  adjustment: Adjustment volume_adjustment {
                    lower: 0;
                    upper: 1;
                    step-increment: 0.05;
                    page-increment: 0.1;
                    value: 1;
                  };
                  tooltip-text: _("Volume");
                  sensitive: false;
                  valign: center;

                  styles [
                    "flat",
                  ]
                }
              }
            };
          };

          // The pane: the divider's grip (drawn here, under the paned's own handle, which
          // takes the pointer over it: style.css), then the sheet's LyricsView or QueueView
          // while one shows. The view places the divider as one opens (do_size_allocate).
          end-child: Box pane_box {
            orientation: vertical;
            visible: false;

            Adw.Bin {
              halign: center;
              can-target: false;

              styles [
                "mini-divider",
              ]
            }

            Adw.Bin pane_slot {
              vexpand: true;

              styles [
                "mini-pane",
              ]
            }
          };
        };
      };
    }
  };
}
