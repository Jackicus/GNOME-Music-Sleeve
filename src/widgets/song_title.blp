using Gtk 4.0;

// The parts most cells never show are made by song_title.py the first time one does (the
// selection mode's check box before the thumbnail, the play icon over it, the explicit badge
// after the title, the artist's line under it): a view keeps 200 rows.
template $AppleMusicSongTitle: Box {
  spacing: 12;

  // The thumbnail. A cover keeps to its own size (it does not expand), so the title starts
  // right after it whatever the column's width. The track playing has a play icon laid over
  // it (shown by opacity: nothing in a recycled row changes size).
  Overlay cover_overlay {
    valign: center;

    child: $AppleMusicCover cover {
      size: 32;

      styles [
        "small",
      ]
    };
  }

  // The title and, in the narrow table (set_stacked()), the artist under it.
  Box text_box {
    orientation: vertical;
    valign: center;
    hexpand: true;

    Box title_box {
      spacing: 6;

      // A label rather than a Gtk.Inscription, so the badge follows the title's text. One
      // line only: measuring it again at every rebind is cheap, unlike a wrapping label.
      Label label {
        xalign: 0;
        ellipsize: end;
        single-line-mode: true;

        styles [
          "track-title",
        ]
      }
    }
  }

  // A favourite's heart, at the column's end: always there, shown by its opacity
  // (song_title.py).
  Image favourite_icon {
    icon-name: "heart-filled-symbolic";
    pixel-size: 12;
    valign: center;
    opacity: 0;
    accessible-role: presentation;

    styles [
      "dimmed",
    ]
  }
}
