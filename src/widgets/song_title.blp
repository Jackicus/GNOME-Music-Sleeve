using Gtk 4.0;

template $AppleMusicSongTitle: Box {
  spacing: 12;

  // In the table's selection mode (widgets/selection_mode.py): whether the row is selected,
  // the row's (a click or a key on it toggles it; its description says it), shown only in
  // the mode.
  CheckButton check {
    valign: center;
    visible: false;
    can-focus: false;
    can-target: false;
    accessible-role: presentation;

    styles [
      "selection-mode",
    ]
  }

  // The thumbnail. A cover keeps to its own size (it does not expand), so the title starts
  // right after it whatever the column's width. The track playing has a play icon laid over
  // it (shown by opacity: nothing in a recycled row changes size).
  Overlay {
    valign: center;

    child: $AppleMusicCover cover {
      size: 32;

      styles [
        "small",
      ]
    };

    [overlay]
    Box playing_scrim {
      opacity: 0;
      can-target: false;
      accessible-role: presentation;

      styles [
        "osd",
        "playing-scrim",
      ]

      Image {
        icon-name: "media-playback-start-symbolic";
        hexpand: true;
        accessible-role: presentation;
      }
    }
  }

  // The title and, in the narrow table (set_stacked()), the artist under it.
  Box {
    orientation: vertical;
    valign: center;
    hexpand: true;

    Box {
      spacing: 6;

      // A label rather than a Gtk.Inscription, so the badge follows the title's text. One
      // line only: measuring it again at every rebind is cheap, unlike a wrapping label.
      Label label {
        xalign: 0;
        ellipsize: end;
        single-line-mode: true;

        styles [
          "track-title",
        ]
      }

      Label explicit_badge {
        // Translators: the badge marking a song with explicit lyrics, as Apple Music shows it
        label: C_("explicit badge", "E");
        tooltip-text: _("Explicit");
        valign: center;
        visible: false;

        accessibility {
          label: _("Explicit");
        }

        styles [
          "caption",
          "explicit-badge",
        ]
      }
    }

    // The artist, where the table has no column for them: an Inscription, sized by its
    // one line rather than its text.
    Inscription artist_label {
      xalign: 0;
      text-overflow: ellipsize_end;
      visible: false;

      styles [
        "caption",
        "dimmed",
      ]
    }
  }

  // A favourite's heart, at the column's end: always there, shown by its opacity
  // (song_title.py).
  Image favourite_icon {
    icon-name: "heart-filled-symbolic";
    pixel-size: 12;
    valign: center;
    opacity: 0;
    accessible-role: presentation;

    styles [
      "dimmed",
    ]
  }
}
