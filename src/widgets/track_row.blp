using Gtk 4.0;

// One track of an album or playlist (widgets/track_row.py). Everything but the title (and a
// table's links) is a Gtk.Inscription, sized by its characters or lines rather than its text,
// so a recycled row is rebound without being measured again; the title is a one-line label,
// so the explicit badge follows its text. The parts most rows never show are made by
// track_row.py the first time one does: the selection mode's check box at the start, the
// play icon over the thumbnail, the explicit badge, the artist's line under the title.
template $AppleMusicTrackRow: Box {
  spacing: 12;
  // In the middle of a row taller than its line (a detail page's rows keep a minimum height;
  // detail.py's row gives the track row all of it).
  valign: center;

  // Albums: the track number, in a column as wide as two digits, and three when there is
  // room (a box set's hundredth track); a play icon in its place while the track is the one
  // playing. Both pages stay visible, so the stack keeps one size whichever it shows.
  Stack number_stack {
    valign: center;
    visible: false;

    StackPage {
      name: "number";

      child: Inscription number_label {
        min-chars: 2;
        nat-chars: 3;
        xalign: 1;

        styles [
          "numeric",
          "dimmed",
        ]
      };
    }

    StackPage {
      name: "playing";

      child: Image playing_icon {
        icon-name: "media-playback-start-symbolic";
        accessible-role: presentation;

        styles [
          "accent",
        ]
      };
    }
  }

  // Playlists: the track's own thumbnail, with a play icon laid over it while the track is
  // the one playing (shown by opacity: nothing in a recycled row changes size).
  Overlay cover_slot {
    valign: center;
    visible: false;

    child: $AppleMusicCover cover {
      size: 40;

      styles [
        "small",
      ]
    };
  }

  // The title (and, in a list, the artist under it); in a table the artist and the album
  // follow as links (track_row.py adds them), the three columns sharing the width equally
  // (homogeneous) so that every row's line up with the header's.
  Box columns {
    spacing: 12;
    hexpand: true;

    Box text_box {
      orientation: vertical;
      valign: center;
      hexpand: true;

      Box title_box {
        spacing: 6;

        Label title_label {
          xalign: 0;
          ellipsize: end;
          single-line-mode: true;

          styles [
            "track-title",
          ]
        }
      }
    }
  }

  // A favourite's heart, before the time: always there, shown by its opacity (track_row.py).
  Image favourite_icon {
    icon-name: "heart-filled-symbolic";
    pixel-size: 12;
    valign: center;
    opacity: 0;
    accessible-role: presentation;

    styles [
      "dimmed",
    ]
  }

  // "3:41", and room for an hour or more ("1:02:03") when the row has it.
  Inscription duration_label {
    min-chars: 5;
    nat-chars: 7;
    xalign: 1;
    valign: center;

    styles [
      "numeric",
      "dimmed",
    ]
  }
}
