using Gtk 4.0;

// A title row over a horizontal row of tiles that scrolls sideways, with no scrollbar: the
// arrows page it. The page scrolls vertically around it: the row's scrolled window never
// scrolls vertically, so a vertical wheel over it goes on to the page's (see shelf.py).
template $AppleMusicShelf: Box {
  orientation: vertical;

  Box {
    spacing: 6;
    margin-start: 24;
    margin-end: 14;

    styles [
      "shelf-header",
    ]

    // The title, and under it the line Apple gives some shelves (a recommendation's
    // reason): shown only when the shelf has one.
    Box {
      orientation: vertical;
      valign: center;
      hexpand: true;

      // Onto a second line rather than cut short where the arrows and See All leave it
      // too little room (a 360 px window).
      Label title_label {
        xalign: 0;
        wrap: true;
        wrap-mode: word_char;
        lines: 2;
        ellipsize: end;

        styles [
          "title-2",
        ]
      }

      Label subtitle_label {
        xalign: 0;
        ellipsize: end;
        visible: false;

        styles [
          "dimmed",
        ]
      }
    }

    // Page the row sideways, for a pointer without a sideways wheel, the row showing no
    // scrollbar: shown while the row overflows, each sensitive while there is more that
    // way (shelf.py).
    Button previous_button {
      icon-name: "go-previous-symbolic";
      tooltip-text: _("Scroll Left");
      valign: center;
      visible: false;

      styles [
        "flat",
        "circular",
      ]
    }

    Button next_button {
      icon-name: "go-next-symbolic";
      tooltip-text: _("Scroll Right");
      valign: center;
      visible: false;

      styles [
        "flat",
        "circular",
      ]
    }

    // Shown only when the row does not show everything (shelf.py); described by the title,
    // so that each shelf's reads differently.
    Button see_all_button {
      label: _("See All");
      valign: center;
      visible: false;

      accessibility {
        described-by: [
          title_label,
        ];
      }

      styles [
        "flat",
      ]
    }
  }

  // EXTERNAL: no scrollbar for the pointer to land on as it scrolls the page, but the row
  // still scrolls (a touchpad, a tilting wheel, Shift and the wheel, a finger, the focus).
  ScrolledWindow scrolled_window {
    hscrollbar-policy: external;
    vscrollbar-policy: never;

    // Recycled like the grids: a Gtk.ListView as the scrolled window's own child. Its
    // factory and handlers are shelf.py's, connected weakly.
    child: ListView list_view {
      orientation: horizontal;
      single-click-activate: true;
      tab-behavior: item;

      styles [
        "shelf-list",
      ]
    };
  }
}
