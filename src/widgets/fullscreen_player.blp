using Gtk 4.0;
using Adw 1;

// The full-screen player (widgets/fullscreen_player.py): the backdrop (the artwork's colours,
// blurred, under a scrim) under a toolbar view whose flat header bar (Leave Fullscreen, More
// Options, the heart, the volume, the lyrics' Translation and Pronunciation menu) the content
// extends under; the content a grid of the item (the artwork, the title and the artist), the
// controls (the seek bar and the transport) and the lyrics' slot, which the LyricsView is
// moved into while the player shows. fullscreen_player.py places them for the view's size
// (fullscreen.layout_for). `osd`: white text, and controls styled for an on-screen display.
template $AppleMusicFullscreenPlayer: Adw.Bin {
  accessible-role: group;

  accessibility {
    label: _("Fullscreen Player");
  }

  styles [
    "fullscreen-player",
    "osd",
  ]

  child: Overlay overlay {
    child: $AppleMusicArtworkBackdrop backdrop {};

    [overlay]
    Adw.ToastOverlay toast_overlay {
      child: Adw.ToolbarView toolbar {
        top-bar-style: flat;
        extend-content-to-top-edge: true;

        [top]
        Adw.HeaderBar header {
          show-title: false;
          show-start-title-buttons: false;
          show-end-title-buttons: false;

          styles [
            "fullscreen-header",
          ]

          [end]
          Button leave_button {
            icon-name: "view-restore-symbolic";
            tooltip-text: _("Leave Fullscreen");
            action-name: "win.fullscreen-player";
            valign: center;
          }

          // The item playing's menu (Go to Album, Go to Artist, Add to Playlist…), made as
          // it opens.
          [end]
          MenuButton more_button {
            icon-name: "view-more-symbolic";
            tooltip-text: _("More Options");
            sensitive: false;
            valign: center;

            accessibility {
              label: _("More Options");
            }
          }

          [end]
          ToggleButton heart_button {
            icon-name: "heart-outline-symbolic";
            tooltip-text: _("Favourite");
            sensitive: false;
            valign: center;

            accessibility {
              label: _("Favourite");
            }

            styles [
              "heart-button",
            ]
          }

          [end]
          ScaleButton volume_button {
            icons: [
              "audio-volume-muted-symbolic",
              "audio-volume-high-symbolic",
              "audio-volume-low-symbolic",
              "audio-volume-medium-symbolic",
            ];
            adjustment: Adjustment volume_adjustment {
              lower: 0;
              upper: 1;
              step-increment: 0.05;
              page-increment: 0.1;
              value: 1;
            };
            tooltip-text: _("Volume");
            sensitive: false;
            valign: center;
          }

          [end]
          MenuButton lyrics_button {
            icon-name: "translate-symbolic";
            tooltip-text: _("Translation and Pronunciation");
            visible: false;
            valign: center;

            accessibility {
              label: _("Translation and Pronunciation");
            }
          }
        }

        content: Grid grid {
          column-spacing: 48;
          row-spacing: 18;

          // The artwork over the titles, or beside them in one column with lyrics.
          Box item_box {
            orientation: vertical;
            spacing: 24;

            layout {
              column: 0;
              row: 0;
            }

            $AppleMusicCover cover {
              size: 320;
              halign: center;

              styles [
                "large",
              ]
            }

            Box titles_box {
              orientation: vertical;
              spacing: 6;
              valign: center;

              Label title_label {
                label: _("Not Playing");
                wrap: true;
                wrap-mode: word_char;
                lines: 2;
                ellipsize: end;
                max-width-chars: 12;

                styles [
                  "title-1",
                ]
              }

              Label subtitle_label {
                wrap: true;
                wrap-mode: word_char;
                lines: 2;
                ellipsize: end;
                max-width-chars: 12;
                visible: false;

                styles [
                  "title-4",
                  "dimmed",
                ]
              }
            }
          }

          // What idle fades out (style.css's .idle), keeping its room and its focus.
          Box controls_box {
            orientation: vertical;
            spacing: 12;
            // The seek slider's expanding stops here: the lyrics' column takes the width.
            hexpand: false;

            layout {
              column: 0;
              row: 1;
            }

            styles [
              "fullscreen-controls",
            ]

            Box seek_box {
              spacing: 6;
              sensitive: false;

              Label elapsed_label {
                label: "0:00";
                xalign: 1;
                width-chars: 5;
                valign: center;

                styles [
                  "numeric",
                  "caption",
                  "dimmed",
                ]
              }

              Scale seek_scale {
                hexpand: true;
                valign: center;
                draw-value: false;
                adjustment: Adjustment seek_adjustment {
                  lower: 0;
                  upper: 1;
                  step-increment: 5;
                  page-increment: 30;
                };

                accessibility {
                  label: _("Position");
                }
              }

              Label remaining_label {
                label: "-0:00";
                xalign: 0;
                width-chars: 6;
                valign: center;

                styles [
                  "numeric",
                  "caption",
                  "dimmed",
                ]
              }
            }

            Box transport_box {
              spacing: 12;
              halign: center;

              ToggleButton shuffle_button {
                icon-name: "media-playlist-shuffle-symbolic";
                tooltip-text: _("Shuffle");
                sensitive: false;
                valign: center;

                styles [
                  "flat",
                  "circular",
                ]
              }

              Button {
                icon-name: "media-skip-backward-symbolic";
                tooltip-text: _("Previous");
                action-name: "app.previous";
                valign: center;

                styles [
                  "flat",
                  "circular",
                  "skip-button",
                ]
              }

              Button play_button {
                icon-name: "transport-play-symbolic";
                tooltip-text: _("Play");
                action-name: "app.play-pause";
                valign: center;

                styles [
                  "circular",
                  "suggested-action",
                  "play-button",
                ]
              }

              Button {
                icon-name: "media-skip-forward-symbolic";
                tooltip-text: _("Next");
                action-name: "app.next";
                valign: center;

                styles [
                  "flat",
                  "circular",
                  "skip-button",
                ]
              }

              ToggleButton repeat_button {
                icon-name: "media-playlist-repeat-symbolic";
                tooltip-text: _("Repeat");
                sensitive: false;
                valign: center;

                styles [
                  "flat",
                  "circular",
                ]
              }
            }
          }

          // The LyricsView, while the player shows (fullscreen.FullscreenHost moves it).
          Adw.Bin lyrics_slot {
            hexpand: true;
            vexpand: true;

            layout {
              column: 1;
              row: 0;
              row-span: 2;
            }
          }
        };
      };
    }
  };
}
