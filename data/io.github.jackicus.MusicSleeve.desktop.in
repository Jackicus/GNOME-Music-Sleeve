[Desktop Entry]
# Translators: the app's name, a proper name: keep it as it is, or write it in your
# language's script.
Name=Music Sleeve
# Translators: “Apple Music” names Apple's service, here and in every other string: keep it
# as it is, untranslated.
Comment=Play your Apple Music library, playlists and radio
Exec=music-sleeve
Icon=@APP_ID@
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Player;GTK;GNOME;
# Translators: Search terms to find this application. Do NOT translate or localize the semicolons.
Keywords=apple;apple music;music;songs;albums;playlists;radio;streaming;lyrics;player;
StartupNotify=true
DBusActivatable=false
X-GNOME-UsesNotifications=true
X-Purism-FormFactor=Workstation;Mobile;
